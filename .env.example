# Copier ce fichier en .env puis adapter.
APP_NAME=Video Intelligence API
ENVIRONMENT=development
DATA_DIR=data
KEEP_MEDIA=false

# Service de récupération séparé (scripts/start.sh le lance sur le port 8001)
FETCHER_URL=http://127.0.0.1:8001

# Transcription locale (tiny | base | small | medium | large-v3)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=fr

# LLM d'analyse : toute API compatible OpenAI. Par défaut Ollama en local.
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_API_KEY=local
ANALYSIS_LANGUAGE=français
